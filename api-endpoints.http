POST {{API_BASE_URL}}/xp-events/
Content-Type: application/json

{
  "module": "training",
  "activity": "workout_session",
  "amount": 50,
  "attribute": "discipline",
  "date": "2026-08-04",
  "created_at": "2026-08-04T12:00:00"
}



@API_BASE_URL = https://fey-backend-g4dz.onrender.com/api

### Quick backend tests

### Check API root
GET {{API_BASE_URL}}/

### Check workouts route
GET {{API_BASE_URL}}/workouts/


### Baseline workout and health data examples

### Create Baseline Workout
POST {{API_BASE_URL}}/workouts/
Content-Type: application/json

{
  "plan_id": "baseline",
  "plan_title": "Russian Twist Baseline",
  "started_at": "2026-06-04T20:35:00Z",
  "completed_at": "2026-06-04T20:40:00Z",
  "duration_minutes": 5,
  "total_sets_completed": 3,
  "total_reps_completed": 36,
  "average_rpe": 4,
  "xp_earned": 50,
  "completed": true,
  "exercises": [
    {
      "exercise_id": "cb_russian_twist",
      "exercise_name": "Russian Twist",
      "category": "core_b",
      "primary_muscle": "Rotational Core",
      "notes": "Baseline weight",
      "sets": [
        { "set_num": 1, "reps": 12, "weight_kg": 6, "duration_sec": 0, "set_type": "working", "completed": true },
        { "set_num": 2, "reps": 12, "weight_kg": 6, "duration_sec": 0, "set_type": "working", "completed": true },
        { "set_num": 3, "reps": 12, "weight_kg": 6, "duration_sec": 0, "set_type": "working", "completed": true }
      ]
    }
  ]
}


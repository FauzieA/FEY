### Create Baseline Weight Log
POST {{API_BASE_URL}}/weight-logs/
Content-Type: application/json

{
  "date": "2026-07-20",
  "weight_kg": 70.5,
  "notes": "Baseline bodyweight"
}

### Create Baseline Measurement Log
POST {{API_BASE_URL}}/measurements/
Content-Type: application/json

{
  "date": "2026-07-20",
  "waist_cm": 85,
  "hips_cm": 100,
  "chest_cm": 95,
  "thigh_cm": 58,
  "arm_cm": 30,
  "notes": "Baseline body measurements"
}


###############################################################################
# FAITH / ISLAM (FaithPage)
###############################################################################

### Get Prayer Logs
GET {{API_BASE_URL}}/salah/

### Create Prayer Log
POST {{API_BASE_URL}}/salah/
Content-Type: application/json

{
  "date": "YYYY-MM-DD",
  "fajr": "on_time|pending|missed",
  "dhuhr": "on_time|pending|missed",
  "asr": "on_time|pending|missed",
  "maghrib": "on_time|pending|missed",
  "isha": "on_time|pending|missed"
}

### Update Prayer Log
# Replace 1 with the prayer id you want to update
PATCH {{API_BASE_URL}}/salah/1/
Content-Type: application/json

{
  "date": "YYYY-MM-DD",
  "fajr": "on_time|pending|missed",
  "dhuhr": "on_time|pending|missed",
  "asr": "on_time|pending|missed",
  "maghrib": "on_time|pending|missed",
  "isha": "on_time|pending|missed"
}

### Create Quran Reading Log
POST {{API_BASE_URL}}/quran-reading/
Content-Type: application/json

{
  "date": "2026-08-04",
  "surah": "Al-Fatiha",
  "from_ayah": 1,
  "to_ayah": 7,
  "pages": 1,
  "minutes": 15,
  "reflection": "Started the day with focus"
}

### Create Memorization Entry
POST {{API_BASE_URL}}/memorization-entries/
Content-Type: application/json

{
  "surah": "Al-Mulk",
  "from_ayah": 1,
  "to_ayah": 10,
  "status": "learning",
  "started_at": "2026-08-04T10:00:00Z",
  "last_reviewed_at": "2026-08-04T10:00:00Z"
}

### Update Memorization Entry
# Replace 1 with the memorization entry id you want to update
PATCH {{API_BASE_URL}}/memorization-entries/1/
Content-Type: application/json

{
  "status": "learning|memorized|needs-work",
  "last_reviewed_at": "YYYY-MM-DD"
}

### Create Revision Log
POST {{API_BASE_URL}}/revisions/
Content-Type: application/json

{
  "date": "2026-08-04",
  "surah": "Al-Mulk",
  "quality": 5,
  "notes": "Recalled the opening verses clearly"
}

### Get Adhkar Logs
GET {{API_BASE_URL}}/adhkar/

### Create Adhkar Log
POST {{API_BASE_URL}}/adhkar/
Content-Type: application/json

{
  "date": "2026-08-04",
  "morning": true,
  "evening": false,
  "after_prayer": true,
  "istighfar_count": 3,
  "completed_items": ["morning_1", "after_prayer_1"]
}

### Update Adhkar Log
# Replace 1 with the adhkar log id you want to update
PATCH {{API_BASE_URL}}/adhkar/1/
Content-Type: application/json

{
  "date": "YYYY-MM-DD",
  "morning": false,
  "evening": false,
  "after_prayer": false,
  "istighfar_count": 0,
  "completed_items": ["morning_item1", "evening_item2"]
}

### Create Missed Fast
POST {{API_BASE_URL}}/missed-fasts/
Content-Type: application/json

{
  "missed_on": "2026-08-03",
  "reason": "Travel",
  "made_up_on": null
}

### Update Missed Fast
# Replace 1 with the missed fast id you want to update
PATCH {{API_BASE_URL}}/missed-fasts/1/
Content-Type: application/json

{
  "missed_on": "YYYY-MM-DD",
  "reason": "string",
  "made_up_on": "YYYY-MM-DD"
}

###############################################################################
# TRAINING (WorkoutHubPage, TrainingPage, DashboardPage)
###############################################################################

### Get Workout Sessions
GET {{API_BASE_URL}}/workouts/

### Create Workout Session
POST {{API_BASE_URL}}/workouts/
Content-Type: application/json

{
  "plan_id": "test",
  "plan_title": "Test Workout",
  "started_at": "2026-08-04T12:00:00Z",
  "completed_at": "2026-08-04T12:00:00Z",
  "duration_seconds": 3600,
  "duration_minutes": 60,
  "total_sets_completed": 1,
  "total_reps_completed": 10,
  "average_rpe": 0,
  "session_rating": null,
  "xp_earned": 0,
  "completed": true,
  "exercises": [
    {
      "exercise_id": "bench_press",
      "exercise_name": "Bench Press",
      "category": null,
      "primary_muscle": null,
      "notes": null,
      "sets": [
        {
          "set_num": 1,
          "reps": 10,
          "weight_kg": 20,
          "duration_sec": 0,
          "set_type": "working",
          "rpe": null,
          "estimated_1rm": 0,
          "rest_seconds_after": 0,
          "completed": true
        }
      ]
    }
  ]
}

### Create Personal Record
POST {{API_BASE_URL}}/personal-records/
Content-Type: application/json

{
  "exercise_id": "bench_press",
  "weight": 100,
  "reps": 5,
  "date": "2026-08-04"
}


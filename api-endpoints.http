### Get Cycle Logs
GET {{API_BASE_URL}}/cycle-logs/

### Create Cycle Log
POST {{API_BASE_URL}}/cycle-logs/
Content-Type: application/json

{
  "start_date": "2026-08-01",
  "end_date": null,
  "symptoms": "Mild cramps",
  "flow": 3
}

### Update Cycle Log
# Replace 1 with the cycle log id you want to update
PATCH {{API_BASE_URL}}/cycle-logs/1/
Content-Type: application/json

{
  "end_date": "YYYY-MM-DD"
}

### Delete Cycle Log
# Replace 1 with the cycle log id you want to delete
DELETE {{API_BASE_URL}}/cycle-logs/1/

### Create Health Note
POST {{API_BASE_URL}}/health-notes/
Content-Type: application/json

{
  "date": "2026-08-04",
  "category": "general",
  "title": "Hydration reminder",
  "details": "Drink more water today"
}

###############################################################################
# LIBRARY (LibraryPage)
###############################################################################

### Create Book
POST {{API_BASE_URL}}/books/
Content-Type: application/json

{
  "title": "Atomic Habits",
  "author": "James Clear",
  "total_pages": 320,
  "current_page": 42,
  "status": "reading",
  "started_at": "2026-08-01",
  "finished_at": null,
  "rating": 5,
  "notes": "Great practical guidance",
  "series_name": "",
  "expected_release_date": null
}

### Update Book
# Replace 1 with the book id you want to update
PATCH {{API_BASE_URL}}/books/1/
Content-Type: application/json

{
  "current_page": 50,
  "status": "reading|finished|waiting",
  "finished_at": "YYYY-MM-DD",
  "rating": 5,
  "notes": "string"
}

### Create Reading Session
POST {{API_BASE_URL}}/reading-sessions/
Content-Type: application/json

{
  "book": 1,
  "date": "2026-08-04",
  "pages_read": 20,
  "minutes": 30
}


# PERFUMERY (PerfumeryPage)
###############################################################################

### Create Perfume Formula
POST {{API_BASE_URL}}/perfume-formulas/
Content-Type: application/json

{
  "name": "Morning Breeze",
  "inspiration": "Fresh citrus and clean woods",
  "created_at": "2026-08-04",
  "archived": false
}

### Update Perfume Formula
# Replace 1 with the perfume formula id you want to update
PATCH {{API_BASE_URL}}/perfume-formulas/1/
Content-Type: application/json

{
  "name": "string",
  "inspiration": "string",
  "archived": false
}

### Create Perfume Version
POST {{API_BASE_URL}}/perfume-versions/
Content-Type: application/json

{
  "formula": 1,
  "version": "v1",
  "date": "2026-08-04",
  "unit": "drops",
  "ingredients": [
    {
      "name": "Bergamot",
      "note": "top",
      "amount": 10
    }
  ],
  "observations": "Bright opening",
  "rating": 5
}

